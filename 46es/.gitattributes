# Keep hash-checked text identical in Windows and Unix checkouts.
*.md text eol=lf
*.py text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
# CAD/export bytes are inputs to the geometry and file-hash checks.
*.sc -text
*.stl -text
*.step -text
*.dwg -text
*.dxf -text
*.png -text
# Generated CAD rewritten on every regeneration (about 18 MB each time) lives in Git LFS from 2026-11-10
# (improvement plan 4-6). Earlier commits keep the plain blobs; the history is not rewritten.
model/*.sc filter=lfs diff=lfs merge=lfs -text
